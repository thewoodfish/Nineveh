[Unit]
Description=Keep the demo contract inside the free tier's six-hour start window

[Timer]
# Every four hours, not daily: a visitor must be able to start a project within six
# hours of the contract's publish, so the gap has to stay comfortably under that even
# if one run fails.
OnCalendar=*-*-* 00/4:00:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
