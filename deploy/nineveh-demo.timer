[Unit]
Description=Keep the demo contract inside the free tier's six-hour start window

[Timer]
# Four-hourly, which is now a health check rather than a republish: the contract keeps
# its address and the job only publishes when devnet has been wiped and taken it. The
# cadence is how quickly that is noticed, and most runs send no transaction at all.
OnCalendar=*-*-* 00/4:00:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
