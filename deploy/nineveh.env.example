# /etc/nineveh/nineveh.env — chmod 600, owned by root. It holds two secrets.
#
# SIGN-IN IS NOT OPTIONAL WHEN THIS IS REACHABLE FROM THE INTERNET.
#
# Without NINEVEH_GITHUB_CLIENT_ID the plane runs in local mode: no sign-in, and every
# caller is treated as the owner of every project. It refuses to *listen* on anything
# but loopback in that mode — but a reverse proxy in front of loopback defeats that,
# because the check is on the listen address, not on who can reach it. So: if Caddy is
# in front of this, set the GitHub variables. There is no other guard.

NINEVEH_DATABASE_URL=postgres:///nineveh
APTOS_API_KEY_TESTNET=aptoslabs_...        # https://geomi.dev — testnet only for now

NINEVEH_GITHUB_CLIENT_ID=
NINEVEH_GITHUB_CLIENT_SECRET=
NINEVEH_PUBLIC_URL=https://api.nineveh.dev
NINEVEH_STUDIO_URL=https://studio.nineveh.dev

# It listens on 127.0.0.1:4000 by default, which is what Caddy proxies to. There is no
# environment variable for it — pass --listen in the unit if you need another address.

RUST_LOG=info
