# /etc/caddy/Caddyfile — TLS, and nothing else. Nineveh speaks plain HTTP.
#
# Caddy gets certificates from Let's Encrypt on first request and renews them itself,
# so there is no cron job and no certbot here.

api.nineveh.dev {
	reverse_proxy 127.0.0.1:4000

	# The change feed is Server-Sent Events: a long-lived response that must not be
	# buffered or it arrives in lumps, and must not time out or it drops every minute.
	@feed path_regexp ^/projects/[^/]+/v1/changes
	reverse_proxy @feed 127.0.0.1:4000 {
		flush_interval -1
		transport http {
			response_header_timeout 24h
		}
	}

	encode gzip
	log {
		output file /var/log/caddy/api.log

		# Keys out of the log.
		#
		# `EventSource` cannot set a header, so the change feed takes the project key as
		# `?apikey=` and the docs tell people to send it that way. Caddy redacts the
		# `Authorization` and `Cookie` headers on its own, but nothing redacts a query
		# string, and an access log is the worst place for a credential to settle: it is
		# backed up, copied into tickets, and read by anyone with a shell, and a key
		# already written there outlives being rotated.
		#
		# `replace` rather than `delete` so the line still says a key was sent and which
		# path it went to, which is what the log is for.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace apikey REDACTED
				}
			}
		}
	}
}
