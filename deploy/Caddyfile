# /etc/caddy/Caddyfile — TLS, and nothing else. Nineveh speaks plain HTTP.
#
# Caddy gets certificates from Let's Encrypt on first request and renews them itself,
# so there is no cron job and no certbot here.

api.nineveh.dev {
	reverse_proxy 127.0.0.1:4000

	# The change feed is Server-Sent Events: a long-lived response that must not be
	# buffered or it arrives in lumps, and must not time out or it drops every minute.
	@feed path_regexp ^/projects/[^/]+/v1/changes
	reverse_proxy @feed 127.0.0.1:4000 {
		flush_interval -1
		transport http {
			response_header_timeout 24h
		}
	}

	# Where the demo contract is right now. `deploy/demo.sh` republishes it every few
	# hours and rewrites this file; the demo page reads it to know what to fire. Public
	# and read-only — it holds one devnet address and nothing else — and served from
	# here rather than from the site because the site is a static export deployed
	# elsewhere, and this value changes without a site build.
	handle /demo.json {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=60"
		root * /var/lib/nineveh/public
		file_server
	}

	encode gzip
	log {
		output file /var/log/caddy/api.log
	}
}
