# Where the project is, and the key to read it with.
#
# Running the plane yourself in local mode, loopback needs no key and the default below
# is already right — leave both unset. Against a hosted project, paste its URL and a
# read key from Studio → Settings → API keys. The key reaches the browser, which is
# fine: reads never touch the chain, so an exposed read key spends no stream credit.
VITE_NINEVEH_PROJECT=http://127.0.0.1:4000/projects/market
VITE_NINEVEH_KEY=
